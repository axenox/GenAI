                "tools": {
                    "get_docs": {
                        "alias": "axenox.GenAI.GetDocsTool",
                        "description": "Load a concrete markdown documentation page from a visible Power UI / ExFace documentation link. Use this only when the embedded concepts or sitemap show a relevant documentation link and the user asks for details or an explanation needs verification. Do not guess documentation URLs; use only links visible in the embedded documentation or previously loaded docs.",
                        "arguments": [
                            {
                                "name": "url",
                                "description": "Markdown documentation URL. Use local URLs starting with api/docs or another documentation link that is visibly present in the embedded or loaded docs. Do not invent paths.",
                                "data_type": {
                                    "alias": "exface.Core.String"
                                }
                            }
                        ]
                    },
                    "GetObject": {
                        "alias": "axenox.GenAI.ModelObjectInfoTool",
                        "description": "Load metamodel information for a metaobject by fully qualified alias, UID, object name or search term. Use this when explaining concrete Power UI objects, attributes, relations or installation-specific aliases, for example exface.Core.PAGE, exface.Core.OBJECT, exface.Core.ATTRIBUTE or an app-specific business object.",
                        "arguments": [
                            {
                                "name": "object_alias",
                                "description": "Fully qualified object alias like exface.Core.PAGE, an object UID like 0x..., or a search term from an object name or alias.",
                                "data_type": {
                                    "alias": "exface.Core.String"
                                }
                            }
                        ]
                    },
                    "GetUxonPrototype": {
                        "alias": "axenox.GenAI.ModelPrototypeInfoTool",
                        "description": "Load UXON prototype documentation for configurable PHP classes. Use this before explaining concrete UXON properties of actions, behaviors, data connectors, data types or other non-widget prototypes. The selector must be a PHP class starting with backslash or a file path relative to the vendor folder; alias selectors are not supported.",
                        "arguments": [
                            {
                                "name": "selector",
                                "description": "PHP class beginning with backslash or file path relative to the vendor folder, for example exface/core/Actions/ShowDialog.php or \\exface\\Core\\Actions\\ShowDialog.",
                                "data_type": {
                                    "alias": "exface.Core.String"
                                }
                            }
                        ]
                    },
                    "GetWidgetType": {
                        "alias": "axenox.GenAI.ModelWidgetTypeInfoTool",
                        "description": "Load detailed documentation for a widget prototype, including supported UXON properties, widget functions and presets. Use this when explaining or sketching widgets such as DataTable, Form, Dialog, Tabs, Button, Chart or other Page/UXON widgets.",
                        "arguments": [
                            {
                                "name": "path",
                                "description": "Widget type or widget PHP file path relative to the vendor folder, for example DataTable, Form, Dialog, Tabs or exface/core/Widgets/DataTable.php.",
                                "data_type": {
                                    "alias": "exface.Core.String"
                                }
                            }
                        ]
                    }
