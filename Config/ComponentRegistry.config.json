{
  "ai_agent": {
    "name": "AI agent",
    "description": "Versioned AI agents that assemble instructions and tools and process prompts through a configured model connection.",
    "uxon_properties": ["agent_alias"],
    "selector": {
      "class": "\\axenox\\GenAI\\Common\\Selectors\\AiAgentSelector",
      "factory": "\\axenox\\GenAI\\Factories\\AiFactory::createFromSelector"
    },
    "prototypes": {
      "app_subfolder": "AI/Agents"
    },
    "documentation": {
      "app_docs": "https://github.com/axenox/GenAI/blob/master/Docs/AI/Agents/index.md",
      "markdown_printer_class": "\\exface\\Core\\Facades\\DocsFacade\\MarkdownPrinters\\GenericUxonComponentMarkdownPrinter"
    },
    "search_selector_data": {
      "object_alias": "axenox.GenAI.AI_AGENT",
      "filters": {
        "operator": "OR",
        "conditions": [
          {"expression": "ALIAS_WITH_NS", "comparator": "=", "value": "[#~query#]"},
          {"expression": "NAME", "comparator": "=", "value": "[#~query#]"}
        ]
      },
      "columns": [
        {"attribute_alias": "NAME"},
        {"attribute_alias": "ALIAS_WITH_NS", "name": "Selector"}
      ]
    },
    "search_prototype_data": {
      "object_alias": "axenox.GenAI.AI_AGENT_PROTOTYPE",
      "filters": {
        "operator": "OR",
        "conditions": [
          {"expression": "NAME", "comparator": "=", "value": "[#~query#]"}
        ]
      },
      "columns": [
        {"attribute_alias": "NAME"},
        {"attribute_alias": "PATHNAME_RELATIVE", "name": "Selector"}
      ]
    }
  },
