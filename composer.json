{
    "name": "axenox/genai",
    "license": [
        "GPL-3.0+",
        "proprietary"
    ],
    "support": {
        "source": "https://github.com/axenox/GenAI",
        "docs": "https://github.com/axenox/GenAI/blob/master/Docs",
        "issues": "https://github.com/axenox/GenAI/issues"
    },
    "require": {
        "exface/core": "^1.0",
        "mcp/sdk": "~0.8",
        "npm-asset/deep-chat": "^2",
        "symfony/expression-language": "^5.3||^6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5||^11||^12||^13"
    },
    "autoload": {
        "psr-4": {
            "axenox\\GenAI\\": ""
        },
        "exclude-from-classmap": [
            "/Config/",
            "/Translations/",
            "/Model/"
        ]
    },
    "bin": [
        "bin/mcp"
    ],
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit"
    },
    "extra": {
        "app": {
            "app_uid": "0x11efbd2d8f0ae0babd2dc84bd653ed63",
            "app_alias": "axenox.GenAI"
        }
    }
}